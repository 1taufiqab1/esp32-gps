  "fileGroups": {
    "group-esp32": [
      {
        "name": "secrets.h",
        "content": "#ifndef SECRETS_H\n#define SECRETS_H\n\nstatic const char* const wifi_ssid = \"Velxio-GUEST\";\nstatic const char* const wifi_password = \"\";\n\nstatic const char* const mqtt_server = \"test.mosquitto.org\";\nstatic const int mqtt_port = 1884;\nstatic const char* const mqtt_username = \"rw\";\nstatic const char* const mqtt_password = \"readwrite\";\n\n#endif"
      },
      {
        "name": "sketch.ino",
        "content": "#include <WiFi.h>\n#include <PubSubClient.h>\n#include <TinyGPSPlus.h>\n#include <ArduinoJson.h>\n#include \"secrets.h\"\n\n#define ESP32_RX2_PIN 16\n#define ESP32_TX2_PIN 17\n#define GPS_BAUD 9600\n#define LED_A_PIN 32\n#define LED_B_PIN 33\n#define DEVICE_ID \"esp32:001\"\n\nconst char* mqtt_topic         = \"tracker/devices/\" DEVICE_ID \"/telemetry\";\nconst char* mqtt_command_topic = \"tracker/devices/\" DEVICE_ID \"/command\";\nconst int   mqtt_keep_alive    = 60;\nconst int   msg_size           = 160;\nconst int   cmd_size           = 128;\nconst int   blink_fast_ms      = 150;\nconst int   blink_slow_ms      = 500;\nconst int   blip_ms            = 100;\n\nHardwareSerial gps_serial(2);\nTinyGPSPlus gps;\nWiFiClient wifi_client;\nPubSubClient mqtt(wifi_client);\n\nunsigned long last_send = 0;\nunsigned long last_publish_ok = 0;\nbool gps_enabled = false;\nint interval_seconds = 10;\n\nunsigned long gps_epoch() {\n  int y = gps.date.year();\n  int m = gps.date.month();\n  int d = gps.date.day();\n\n  if (m <= 2) y--;\n  int era = y / 400;\n  int yoe = y - era * 400;\n  int doy = (153 * (m > 2 ? m - 3 : m + 9) + 2) / 5 + d - 1;\n  int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;\n  unsigned long days = era * 146097UL + doe - 719468UL;\n\n  return days * 86400UL + gps.time.hour() * 3600UL +\n         gps.time.minute() * 60UL + gps.time.second();\n}\n\nbool blink_on(unsigned long period_ms) {\n  return (millis() / period_ms) % 2;\n}\n\nvoid update_leds() {\n  bool led_a;\n\n  if (WiFi.status() != WL_CONNECTED) led_a = blink_on(blink_fast_ms);\n  else if (!mqtt.connected())        led_a = blink_on(blink_slow_ms);\n  else                               led_a = true;\n\n  bool led_b;\n\n  if (!gps_enabled)                  led_b = false;\n  else if (!gps.location.isValid())  led_b = blink_on(blink_slow_ms);\n  else led_b = !(last_publish_ok != 0 && millis() - last_publish_ok < blip_ms);\n\n  digitalWrite(LED_A_PIN, led_a);\n  digitalWrite(LED_B_PIN, led_b);\n}\n\nvoid initialize_hardware() {\n  Serial.begin(115200);\n\n  pinMode(LED_A_PIN, OUTPUT);\n  pinMode(LED_B_PIN, OUTPUT);\n\n  gps_serial.begin(GPS_BAUD, SERIAL_8N1, ESP32_RX2_PIN, ESP32_TX2_PIN);\n}\n\nvoid connect_wifi() {\n  WiFi.begin(wifi_ssid, wifi_password);\n\n  Serial.print(\"Connecting to WiFi\");\n\n  unsigned long last_dot = 0;\n\n  while (WiFi.status() != WL_CONNECTED) {\n    update_leds();\n\n    if (millis() - last_dot >= 500) {\n      last_dot = millis();\n      Serial.print(\".\");\n    }\n\n    delay(10);\n  }\n\n  Serial.println(\"\\nWiFi connected\");\n}\n\nvoid initialize_mqtt() {\n  mqtt.setServer(mqtt_server, mqtt_port);\n  mqtt.setKeepAlive(mqtt_keep_alive);\n  mqtt.setCallback(on_message);\n}\n\nvoid reconnect_mqtt() {\n  if (!mqtt.connected()) {\n    if (mqtt.connect(DEVICE_ID, mqtt_username, mqtt_password)) {\n      mqtt.subscribe(mqtt_command_topic);\n      Serial.println(\"MQTT connected, subscribed to command topic\");\n    }\n  }\n}\n\nvoid set_active(bool on) {\n  if (on == gps_enabled) return;\n\n  if (on) gps = TinyGPSPlus();\n\n  gps_enabled = on;\n\n  Serial.println(on ? \"GPS ON\" : \"GPS OFF\");\n}\n\nvoid handle_command(char* cmd) {\n  if (strcmp(cmd, \"1\") == 0 || strcasecmp(cmd, \"true\") == 0) {\n    set_active(true);\n    return;\n  }\n\n  if (strcmp(cmd, \"0\") == 0 || strcasecmp(cmd, \"false\") == 0) {\n    set_active(false);\n    return;\n  }\n\n  StaticJsonDocument<256> doc;\n  DeserializationError err = deserializeJson(doc, cmd);\n\n  if (err || !doc.is<JsonObject>()) {\n    Serial.println(\"Invalid command\");\n    return;\n  }\n\n  if (!doc[\"device_id\"].isNull()) {\n    const char* id = doc[\"device_id\"] | \"\";\n\n    if (strcmp(id, DEVICE_ID) != 0) {\n      Serial.println(\"Command ignored: device_id mismatch\");\n      return;\n    }\n  }\n\n  if (!doc[\"interval_seconds\"].isNull()) {\n    if (doc[\"interval_seconds\"].is<int>()) {\n      int value = doc[\"interval_seconds\"];\n\n      if (value == 2 || value == 5 || value == 10 || value == 30) {\n        interval_seconds = value;\n\n        Serial.print(\"Interval set to \");\n        Serial.print(interval_seconds);\n        Serial.println(\" s\");\n      } else {\n        Serial.println(\"Invalid interval, ignored\");\n      }\n    } else {\n      Serial.println(\"Invalid interval, ignored\");\n    }\n  }\n\n  if (doc[\"active\"].is<bool>()) {\n    set_active(doc[\"active\"]);\n  }\n}\n\nvoid on_message(char* topic, byte* payload, unsigned int length) {\n  char cmd[cmd_size];\n\n  unsigned int n = length < sizeof(cmd) - 1 ? length : sizeof(cmd) - 1;\n  memcpy(cmd, payload, n);\n\n  cmd[n] = '\\0';\n\n  handle_command(cmd);\n}\n\nvoid discard_gps_data() {\n  while (gps_serial.available()) {\n    gps_serial.read();\n  }\n}\n\nvoid read_gps_data() {\n  while (gps_serial.available()) {\n    gps.encode(gps_serial.read());\n  }\n}\n\nbool is_telemetry_interval_elapsed() {\n  return interval_seconds > 0 &&\n         millis() - last_send >= (unsigned long)(interval_seconds * 1000);\n}\n\nvoid print_telemetry(const char* msg) {\n  char time_str[12] = \"--:--:--\";\n\n  if (gps.time.isValid()) {\n    snprintf(\n      time_str,\n      sizeof(time_str),\n      \"%02d:%02d:%02d\",\n      (gps.time.hour() + 7) % 24,\n      gps.time.minute(),\n      gps.time.second()\n    );\n  }\n\n  Serial.print(\"[\");\n  Serial.print(time_str);\n  Serial.print(\"] \");\n  Serial.println(msg);\n}\n\nvoid publish_telemetry() {\n  char msg[msg_size];\n\n  int len = snprintf(\n    msg,\n    sizeof(msg),\n    \"{\\\"device_id\\\":\\\"%s\\\",\\\"lat\\\":%.6f,\\\"lng\\\":%.6f,\\\"speed\\\":%.1f\",\n    DEVICE_ID,\n    gps.location.lat(),\n    gps.location.lng(),\n    gps.speed.knots()\n  );\n\n  if (gps.date.isValid() && gps.time.isValid()) {\n    len += snprintf(\n      msg + len,\n      sizeof(msg) - len,\n      \",\\\"timestamp\\\":%lu\",\n      gps_epoch()\n    );\n  }\n\n  snprintf(msg + len, sizeof(msg) - len, \"}\");\n\n  print_telemetry(msg);\n\n  if (mqtt.publish(mqtt_topic, msg)) {\n    last_publish_ok = millis();\n  }\n}\n\nvoid process_gps() {\n  if (!gps_enabled) {\n    discard_gps_data();\n    return;\n  }\n\n  read_gps_data();\n\n  if (!is_telemetry_interval_elapsed()) return;\n\n  last_send = millis();\n\n  if (gps.location.isValid()) {\n    publish_telemetry();\n  } else {\n    Serial.println(\"Waiting for GPS fix...\");\n  }\n}\n\nvoid setup() {\n  initialize_hardware();\n  connect_wifi();\n  initialize_mqtt();\n}\n\nvoid loop() {\n  reconnect_mqtt();\n  mqtt.loop();\n  update_leds();\n  process_gps();\n}"
      }
    ]
  },
